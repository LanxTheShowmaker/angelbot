{
  "name": "wings",
  "version": "1.0.0",
  "description": "WINGS — a bespoke, premium Discord application for a single private server.",
  "type": "module",
  "main": "src/core/bootstrap.js",
  "scripts": {
    "start": "node src/core/bootstrap.js",
    "dev": "node --watch src/core/bootstrap.js",
    "deploy": "node src/core/deploy.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
