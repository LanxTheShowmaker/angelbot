{
  "name": "angel",
  "version": "1.0.0",
  "description": "A.N.G.E.L. — a global, per-server configurable Discord application with autosetup.",
  "type": "module",
  "main": "src/core/bootstrap.js",
  "scripts": {
    "start": "node --max-old-space-size=256 --enable-source-maps src/core/bootstrap.js",
    "start:lite": "node --max-old-space-size=224 --optimize-for-size src/core/bootstrap.js",
    "start:index": "node --max-old-space-size=256 index.js",
    "dev": "node --watch src/core/bootstrap.js",
    "deploy": "node src/core/deploy.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
