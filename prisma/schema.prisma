generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  guildId          String   @id
  logChannelId     String?
  modLogChannelId  String?
  welcomeChannelId String?
  goodbyeChannelId String?
  staffRoleIds     String   @default("[]")
  moderatorRoleIds String   @default("[]")
  ignoredChannelIds String   @default("[]")
  ignoredRoleIds   String   @default("[]")
  ignoredUserIds   String   @default("[]")
  modules          String   @default("{}")
  automod          String   @default("{}")
  orders           String   @default("{}")
  prefix           String   @default("!")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Case {
  id           Int      @id @default(autoincrement())
  guildId      String
  caseNumber   Int
  targetId     String
  targetTag    String
  moderatorId  String
  moderatorTag String
  action       String
  reason       String?
  duration     String?
  durationMs   BigInt?
  resolved     Boolean  @default(false)
  resolvedById String?
  resolvedByTag String?
  resolvedAt   DateTime?
  metadata     String?
  createdAt    DateTime @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
}

model Order {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String    @unique
  openerId    String
  claimedById String?
  category    String
  status      String    @default("BRIEF")
  brief       String?
  budget      String?
  deadline    DateTime?
  references  String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  transcript  String?
  @@index([guildId, status])
}

model FortressState {
  guildId     String    @id
  active      Boolean   @default(false)
  enabledById String?
  enabledByTag String?
  startedAt   DateTime?
  snapshot    String
}

model Reminder {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  userId    String
  message   String
  remindAt  DateTime
  createdAt DateTime @default(now())
  @@index([remindAt])
}

model Poll {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String   @unique
  authorId  String
  question  String
  options   String
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

model Panel {
  id              String   @id @default(uuid())
  guildId         String
  panelType       String
  channelId       String?
  messageId       String?
  title           String?
  description     String?
  bannerUrl       String?
  bannerChannelId String?
  bannerMessageId String?
  thumbnailUrl    String?
  embedColor      Int?
  footerText      String?
  footerIcon      String?
  enabled         Boolean  @default(false)
  config          String   @default("{}")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([guildId, panelType])
  @@index([guildId])
}

model TicketType {
  id               String  @id @default(uuid())
  guildId          String
  panelType        String
  key              String
  displayName      String
  description      String?
  emoji            String?
  enabled          Boolean @default(true)
  categoryId       String?
  staffRoleIds     String  @default("[]")
  moderatorRoleIds String  @default("[]")
  channelPrefix    String? @default("ticket")
  welcomeMessage   String?
  instructions     String?
  bannerUrl        String?
  priority         String  @default("NORMAL")
  cooldown         Int     @default(0)
  maxOpen          Int     @default(1)
  allowClaim       Boolean @default(true)
  questions        String  @default("[]")

  @@unique([guildId, key])
  @@index([guildId, panelType])
}

model Ticket {
  id          String    @id @default(uuid())
  guildId     String
  channelId   String    @unique
  openerId    String
  typeId      String?
  panelType   String?
  status      String    @default("OPEN")
  priority    String    @default("NORMAL")
  claimedById String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  transcript  String?

  @@index([guildId, openerId])
  @@index([guildId, status])
}

model Xp {
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  updatedAt DateTime @updatedAt
  @@id([guildId, userId])
  @@index([guildId, level])
}

model Economy {
  guildId   String
  userId    String
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  @@id([guildId, userId])
}

model ShopItem {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  description String?
  price       Int
  roleId      String?
  emoji       String?
  stock       Int?
  createdAt   DateTime @default(now())
  @@unique([guildId, name])
  @@index([guildId])
}

model ShopInventory {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  itemId      String
  quantity    Int      @default(1)
  purchasedAt DateTime @default(now())
  @@index([guildId, userId])
  @@unique([guildId, userId, itemId])
}

model ReactionRole {
  id        String @id @default(uuid())
  guildId   String
  channelId String
  messageId String
  emoji     String
  roleId    String
  @@unique([guildId, messageId, emoji])
  @@index([guildId])
}

model Giveaway {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String   @unique
  prize     String
  winners   Int      @default(1)
  endsAt    DateTime
  ended     Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([endsAt])
}

model Suggestion {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String   @unique
  authorId  String
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  @@index([guildId, status])
}

model StarboardConfig {
  guildId   String @id
  channelId String
  threshold Int    @default(3)
  emoji     String @default("⭐")
}

model Afk {
  guildId   String
  userId    String
  reason    String?
  since     DateTime @default(now())
  @@id([guildId, userId])
}
