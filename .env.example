DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_primary_guild_id
DATABASE_URL="postgresql://wings:wings@localhost:5432/wings?schema=public"

# Optional: a second guild the bot also serves (private server may have a staging guild)
EXTRA_GUILD_IDS=

# Logging
LOG_LEVEL=info

# Web dashboard (future) — not required for the bot
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_long_random_string
