DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
DATABASE_URL="file:./wings.db"

# Dev only — instant guild deploy for testing (omit for global public deploy)
# GUILD_ID=your_dev_guild_id

# Optional: comma-separated guilds for bulk deploy (npm run deploy handles global if GUILD_ID is empty)

# Logging
LOG_LEVEL=info

# Web dashboard (future) — not required for the bot
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_long_random_string
